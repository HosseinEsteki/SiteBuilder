{
    "name": "hosseinesteki/seo",
    "description": "Laravel SEO Module: Meta Manager, Schema Generator, Sitemap, Redirect Manager",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": {

        "artesaos/seotools": "^1.3.2",
        "spatie/schema-org": "^3.23.1",
        "spatie/laravel-sitemap": "^7.3.8"
    },
    "autoload": {
        "psr-4": {
            "Seo\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Seo\\Providers\\SeoServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
